<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Cache databases are useless between devices, drop them -->
    <exclude
        domain="database"
        path="music_cache.db" />
    <!-- The server address and password stay on this device -->
    <exclude
        domain="sharedpref"
        path="server_settings.xml" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cache databases are useless between devices, drop them -->
    <cloud-backup>
        <exclude
            domain="database"
            path="music_cache.db" />
        <!-- The server address and password stay on this device -->
        <exclude
            domain="sharedpref"
            path="server_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="music_cache.db" />
    </device-transfer>
</data-extraction-rules>